# Charis MFB Campaign Centre — environment template.
# Copy to .env.local for development. In production set these in Vercel (never commit real values).

# --- Deployment mode -------------------------------------------------------
# single = one organisation, invite-only, no public site/billing (default for Charis)
# multi  = original multi-company SaaS surface
APP_MODE=single

# --- Application -----------------------------------------------------------
# Public HTTPS origin, no path and no trailing slash.
NEXT_PUBLIC_APP_URL=https://campaign.example.com

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email delivery --------------------------------------------------------
# Keep false until staging acceptance is complete (see MD/CHARIS_GO_LIVE.md).
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Optional second provider.
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=

# --- Delivery worker -------------------------------------------------------
# At least 32 random characters. Also set CRON_SECRET to the same value if you use Vercel Cron.
EMAIL_WORKER_SECRET=
# Optional tuning (defaults shown). Spacing should match the provider minimum interval set in /admin/providers.
# EMAIL_WORKER_BUDGET_MS=100000
# EMAIL_WORKER_SPACING_MS=2100
# EMAIL_WORKER_MAX_ITEMS=500

# --- Billing (APP_MODE=multi only) -----------------------------------------
# PAYSTACK_SECRET_KEY=

# --- Backups (scripts/backup-database.mjs) ---------------------------------
# DATABASE_URL=
